PORT=3000

# SQLite file (use ":memory:" for a throwaway database)
DATABASE_PATH=bookstore.sqlite
# Creates/updates the schema on boot. Turn off once you manage migrations yourself.
DATABASE_SYNCHRONIZE=true

# Secret used to sign access tokens (HS256). Required when NODE_ENV=production.
JWT_SECRET=
# Token lifetime in seconds
JWT_TTL=3600

BCRYPT_ROUNDS=10
